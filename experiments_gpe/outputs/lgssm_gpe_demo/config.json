{
  "experiment": {
    "name": "lgssm_gpe_demo",
    "output_dir": "experiments_gpe/outputs/lgssm_gpe_demo",
    "seed": 0
  },
  "model": {
    "type": "lgssm",
    "state_dim": 8,
    "emission_dim": 4,
    "input_dim": 4,
    "has_dynamics_bias": true,
    "has_emissions_bias": true
  },
  "data": {
    "T": 1000,
    "segment_length": 10,
    "u_max": 1.0,
    "Q_scale": 0.1,
    "R_scale": 0.1
  },
  "train": {
    "algorithm": "sgd",
    "num_iters": 200,
    "trainable_paths": [
      "dynamics.weights",
      "dynamics.input_weights",
      "dynamics.cov",
      "emissions.weights",
      "emissions.input_weights",
      "emissions.cov",
      "initial.mean"
    ]
  },
  "methods": [
    {
      "name": "gpe",
      "eps_cov": 0.35,
      "eps_step": 0.17,
      "num_cover_points": 256,
      "num_candidates": 8192,
      "probe_points": 8192,
      "amplitude": 1.0
    },
    {
      "name": "gaussian_white",
      "sigma": 1.0
    },
    {
      "name": "multisine",
      "K": 8,
      "w_min": 0.02,
      "w_max": 0.3
    },
    {
      "name": "piecewise_gaussian"
    },
    {
      "name": "sphere_random_walk",
      "eps_step": 0.17
    }
  ]
}